# Leave blank for the clearly labelled local demo. Never expose service-role keys with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, server only. Enables grounded AI synthesis after private document retrieval.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Google Drive OPTIONAL: independent OAuth, never use NEXT_PUBLIC_ for these secrets.
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_TOKEN_ENCRYPTION_KEY=
# Server-only Supabase service_role key: used ONLY for encrypted OAuth token RPCs.
SUPABASE_SERVICE_ROLE_KEY=
# Optional external OCR service implementing docs/materials-setup.md contract.
OCR_SERVICE_URL=
OCR_SERVICE_KEY=
